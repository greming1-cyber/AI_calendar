# 이 파일을 .env.local 로 복사해 값을 채운다. .env.local 은 커밋하지 않는다.
# 값은 Supabase 대시보드 → Project Settings → API 에서 확인한다.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용(회원 탈퇴 등). 클라이언트 코드에서 import 하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 구글 캘린더 연동(세션 04). Google Cloud → OAuth 클라이언트(웹), 리디렉션 URI http://localhost:3000/api/google/callback
# 같은 값을 `npx supabase secrets set GOOGLE_CLIENT_ID=… GOOGLE_CLIENT_SECRET=…`로 Edge Function 에도 넣는다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
